---
import { PARTS } from '../data/parts';
import Base from '../layouts/Base.astro';
import { getLessons } from '../lib/lessons';
import { url } from '../lib/url';

const lessons = await getLessons();
---

<Base title="Course map" description="Every lesson in First Moves, from meeting your Move to sampling and sharing your music.">
  <div class="wrap">
    <h1>Course map</h1>
    <p class="lede">Work through the parts in order, or jump to what you need. A tick means you finished that lesson.</p>
    {PARTS.map((part) => {
      const inPart = lessons.filter((l) => l.data.part === part.n);
      return (
        <section class="course-part" id={`part-${part.n}`}>
          <h2><span class="part-num">Part {part.n}</span> {part.title}</h2>
          <p class="muted">{part.blurb}</p>
          {inPart.length > 0 ? (
            <ol class="lesson-list">
              {inPart.map((l) => (
                <li>
                  <a class="lesson-card" href={url(`lessons/${l.id}/`)} data-lesson-link={l.id}>
                    <span class="lesson-num" aria-hidden="true">{l.data.order}</span>
                    <span class="lesson-card-text">
                      <strong>{l.data.title}</strong>
                      <span class="muted">{l.data.summary}</span>
                    </span>
                    <span class="lesson-state" aria-hidden="true"></span>
                    <span class="visually-hidden done-label">(finished)</span>
                  </a>
                </li>
              ))}
            </ol>
          ) : (
            <p class="coming-soon">Coming soon.</p>
          )}
        </section>
      );
    })}
    <p class="reset-row">
      <button type="button" class="button secondary" data-reset>Reset my progress</button>
    </p>
  </div>
</Base>

<script>
  import '../scripts/lesson-status.ts';
</script>
